{
  "title": "System Health Dashboard",
  "timezone": "browser",
  "panels": [
    {
      "title": "API Request Rate",
      "type": "timeseries",
      "targets": [{"expr": "rate(fraud_api_requests_total[5m])"}]
    },
    {
      "title": "P95 Latency",
      "type": "timeseries",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(fraud_api_latency_seconds_bucket[5m])) by (le))"}]
    },
    {
      "title": "API Error Rate",
      "type": "timeseries",
      "targets": [{"expr": "rate(fraud_api_errors_total[5m])"}]
    },
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "targets": [{"expr": "rate(process_cpu_seconds_total[5m])"}]
    },
    {
      "title": "Memory Usage",
      "type": "timeseries",
      "targets": [{"expr": "process_resident_memory_bytes"}]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
